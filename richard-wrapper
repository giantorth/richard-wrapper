#!/bin/bash
# Lutris launch wrapper for Richard Burns Rally. Referenced directly by
# richard-burns-rally.yml via system.prefix_command — not copied.
# Modes (auto-detected from "$@"):
#   - game-simhub  (default; SimHub launched alongside RSF launcher)
#   - game-only    (--rbr-no-simhub flag in args)
#   - installer    (any *Installer*.exe in args)
#
# Verbose logging is OFF by default. To debug a launch, flip ENABLE_LOG=1
# below; output is then truncated and rewritten to LOG_FILE each launch.
# When OFF, the wrapper's own status lines go to its caller's stdout/stderr
# (Lutris game log / terminal), and SimHub's output is discarded.

ENABLE_LOG=0
LOG_FILE="/tmp/richard-wrapper.log"

if [ "$ENABLE_LOG" = "1" ]; then
    LOG="$LOG_FILE"
    : > "$LOG"
    exec >>"$LOG" 2>&1
else
    LOG=/dev/null
fi
echo "=========================================="
echo "[$(date '+%F %T')] wrapper invoked"
echo "  argv0           : $0"
echo "  argc            : $#"
for a in "$@"; do echo "  arg             : $a"; done
echo "  WINEPREFIX (env): ${WINEPREFIX:-<unset>}"
echo "  WINE (env)      : ${WINE:-<unset>}"

MODE="game-simhub"
FILTERED_ARGS=()
for a in "$@"; do
    case "$a" in
        --rbr-no-simhub)
            [ "$MODE" = "game-simhub" ] && MODE="game-only"
            continue ;;
        *Installer*.exe|*Installer*.EXE|*installer*.exe)
            MODE="installer" ;;
    esac
    FILTERED_ARGS+=("$a")
done
echo "  detected mode   : $MODE"
echo "  forwarded args  : ${FILTERED_ARGS[*]}"

if [ -z "$WINEPREFIX" ]; then
    echo "[$(date '+%F %T')] ERROR: WINEPREFIX is not set; Lutris should set this." >&2
    exit 1
fi
PREFIX="$WINEPREFIX"
PREFIX_REAL="$(readlink -f "$PREFIX" 2>/dev/null || printf '%s' "$PREFIX")"
SIMHUB_EXE="$PREFIX/drive_c/Program Files (x86)/SimHub/SimHubWPF.exe"
# Lutris always exports $WINE for wine-runner games; fall back to PATH if not.
WINE_BIN="${WINE:-wine}"

# winehub handoff: a separately-running winehub (in the SimHub prefix) can't see
# our install dir through umu's pressure-vessel, so hand it the RBR path via a
# file it reads at detection. Keyed by the game exe winehub matches on.
HANDOFF_DIR="${XDG_RUNTIME_DIR:-/tmp}/winehub"
HANDOFF_FILE="$HANDOFF_DIR/RichardBurnsRally_SSE.exe"
RBR_INSTALL_DIR=""
for a in "${FILTERED_ARGS[@]}"; do
    case "$a" in *.exe) RBR_INSTALL_DIR="$(dirname "$a")" ;; esac
done
# The launcher lives in <RBR>/rsf_launcher/; the game exe lives in <RBR>/.
if [ "$(basename "$RBR_INSTALL_DIR")" = "rsf_launcher" ]; then
    RBR_INSTALL_DIR="$(dirname "$RBR_INSTALL_DIR")"
fi

# /proc/<pid>/comm is truncated to 15 chars; wine sometimes lowercases.
GAME_COMM="RichardBurnsRal"
LAUNCHER_COMM="RSF_Launcher.ex"
SIMHUB_COMM="SimHubWPF.exe"
INSTALLER_COMM="Rallysimfans_In"

# Settle time after the launcher shows up, not a blind delay from launch — see
# the SimHub starter below.
SIMHUB_START_DELAY="${SIMHUB_START_DELAY:-5}"
# How long to wait for the launcher before starting SimHub anyway.
SIMHUB_WAIT_MAX="${SIMHUB_WAIT_MAX:-90}"
# How long to let the prefix drain after a polite TERM before forcing it, and
# how long to wait for a torn-down prefix to go quiet before launching into it.
PREFIX_TERM_WAIT="${PREFIX_TERM_WAIT:-8}"
PREFIX_CLEAR_TIMEOUT="${PREFIX_CLEAR_TIMEOUT:-20}"
POLL_INTERVAL="${POLL_INTERVAL:-3}"
GRACE_AFTER_GAME="${GRACE_AFTER_GAME:-3}"
HEARTBEAT_INTERVAL=30

# A command-line match is only evidence if the match isn't us: the wrapper's own
# argv carries the exe path Lutris handed it, and so does every subshell we fork.
external_f() {
    local pat="$1" pid cmdline
    for pid in $(pgrep -f "$pat" 2>/dev/null); do
        case "$SELF_CHAIN" in *" $pid "*) continue ;; esac
        cmdline=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)
        case "$cmdline" in
            *richard-wrapper*|*wrapper.sh*|*runrbr_simhub.sh*) continue ;;
        esac
        return 0
    done
    return 1
}

# Match on comm (truncated to 15 chars, and wine sometimes lowercases it, hence
# the case-insensitive prefix). No command-line fallback for the launcher or the
# installer: Lutris puts those paths in our own argv, and the umu-run/proton
# chain carries them too from the moment we start — both would read "alive"
# before wine has done anything, which is exactly when we must not act.
# pgrep also matches zombies. Under plain wine (no umu/pressure-vessel reaper) an
# exited RBR lingers as <defunct> under lutris-wrapper, which would read as alive
# forever and the exit sweep would never run — so only count living processes.
pgrep_live() {
    local pid
    for pid in $(pgrep "$@" 2>/dev/null); do
        [ "$(awk '/^State:/{print $2}' "/proc/$pid/status" 2>/dev/null)" = Z ] || return 0
    done
    return 1
}
game_alive()      { pgrep_live -i "^${GAME_COMM}" || external_f 'RichardBurnsRally_SSE\.exe'; }
launcher_alive()  { pgrep_live -i "^RSF_Launcher"; }
installer_alive() { pgrep_live -i "^Rallysimfans"; }

collect_subtree() {
    local root="$1"; [ -n "$root" ] || return 0; local kid
    for kid in $(pgrep -P "$root" 2>/dev/null); do collect_subtree "$kid"; done
    echo "$root"
}

kill_tree() {
    local root="$1"; [ -n "$root" ] || return 0; local kid
    for kid in $(pgrep -P "$root" 2>/dev/null); do kill_tree "$kid"; done
    if kill -0 "$root" 2>/dev/null; then
        local comm; comm=$(cat "/proc/$root/comm" 2>/dev/null)
        echo "  kill -9 pid=$root ($comm)"
        kill -9 "$root" 2>/dev/null
    fi
}

kill_by_comm() {
    local name="$1" pid comm
    for pid in $(pgrep -ix "$name" 2>/dev/null); do
        comm=$(cat "/proc/$pid/comm" 2>/dev/null)
        echo "  kill -9 pid=$pid ($comm)"
        kill -9 "$pid" 2>/dev/null
    done
}

# This script plus everything above it (lutris-wrapper, Lutris). They can carry
# WINEPREFIX in their environment too, so the prefix sweep must never touch them.
self_chain() {
    local pid=$$ ppid
    while [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null; do
        printf '%s ' "$pid"
        ppid=$(awk '/^PPid:/{print $2}' "/proc/$pid/status" 2>/dev/null)
        [ "$ppid" = "$pid" ] && break
        pid="$ppid"
    done
}
SELF_CHAIN=" $(self_chain) "

prefix_match() {
    local val="${1%/}"
    [ "$val" = "${PREFIX%/}" ] && return 0
    [ "$(readlink -f "$val" 2>/dev/null)" = "$PREFIX_REAL" ]
}

# SimHubWPF.exe itself and the helpers its plugins spawn (e.g. the MOZA
# CoapStub under <SimHub>/MozaPlugin/CoapStub/). Used to spare them in the
# modes where we didn't start SimHub.
simhub_owned() {
    case "$(tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null)" in
        *[Ss]im[Hh]ub*) return 0 ;;
    esac
    return 1
}

# Every process whose environment still points at our prefix. The game and its
# plugins spawn helpers we can't enumerate by name up front, and any survivor
# keeps lutris-wrapper (a child subreaper) alive, so the session never ends and
# the prefix stays dirty. Scoping by WINEPREFIX catches them all. $1 is an extra
# pid to skip — callers pass their own subshell, which inherited WINEPREFIX too.
prefix_pids_all() {
    local skip="$SELF_CHAIN $1 $BASHPID " dir pid kv mine
    for dir in /proc/[0-9]*; do
        pid=${dir#/proc/}
        case "$skip" in *" $pid "*) continue ;; esac
        [ -r "$dir/environ" ] || continue
        mine=0
        {
            while IFS= read -r -d '' kv; do
                case "$kv" in
                    WINEPREFIX=*) prefix_match "${kv#WINEPREFIX=}" && mine=1; break ;;
                esac
            done < "$dir/environ"
        } 2>/dev/null
        [ "$mine" -eq 1 ] && printf '%s\n' "$pid"
    done
}

# In the modes where we didn't start SimHub, spare it and its helpers — but only
# while a SimHub is actually running in this prefix. Otherwise anything
# SimHub-shaped in here is an orphan of an earlier session and has to go.
prefix_pids() {
    local me=$BASHPID pids pid kid spare=" "
    # $BASHPID inside $( ) is the inner subshell's, so grab ours up front —
    # otherwise the scan finds this very subshell (it inherited WINEPREFIX).
    pids=$(prefix_pids_all "$me")
    if [ "$MODE" != "game-simhub" ]; then
        for pid in $pids; do
            [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = "$SIMHUB_COMM" ] || continue
            for kid in $(collect_subtree "$pid"); do spare+="$kid "; done
        done
    fi
    for pid in $pids; do
        if [ "$spare" != " " ]; then
            case "$spare" in *" $pid "*) continue ;; esac
            simhub_owned "$pid" && continue
        fi
        printf '%s\n' "$pid"
    done
}

sweep_prefix() {
    local sig="$1" pid comm
    for pid in $(prefix_pids); do
        kill -0 "$pid" 2>/dev/null || continue
        comm=$(cat "/proc/$pid/comm" 2>/dev/null)
        echo "  kill -$sig pid=$pid ($comm) [prefix]"
        kill "-$sig" "$pid" 2>/dev/null
    done
}

# Wait for the prefix to go quiet. A wineserver that was just killed takes a
# moment to go, and a session that attaches to one mid-teardown comes up broken
# — proton's prefix setup fails and the RSF launcher window never appears. So
# never launch into a prefix that still has processes in it.
wait_prefix_clear() {
    local timeout="${1:-$PREFIX_CLEAR_TIMEOUT}" waited=0 pids pid
    while :; do
        pids=$(prefix_pids)
        if [ -z "$pids" ]; then
            [ "$waited" -gt 0 ] && echo "[$(date '+%F %T')] prefix quiet after ${waited}s"
            return 0
        fi
        [ "$waited" -ge "$timeout" ] && break
        sleep 1
        waited=$((waited + 1))
    done
    echo "[$(date '+%F %T')] prefix still busy after ${timeout}s:"
    for pid in $pids; do
        echo "  $pid $(cat "/proc/$pid/comm" 2>/dev/null)"
    done
    return 1
}

stale_cleanup() {
    local found=0 pid c cmdline stale_comms
    stale_comms=("$GAME_COMM" "$LAUNCHER_COMM" "$INSTALLER_COMM")
    # Only sweep a stale SimHub when we're the ones managing it.
    [ "$MODE" = "game-simhub" ] && stale_comms+=("$SIMHUB_COMM")
    for comm in "${stale_comms[@]}"; do
        for pid in $(pgrep -ix "$comm" 2>/dev/null); do
            if [ "$found" -eq 0 ]; then
                echo "[$(date '+%F %T')] stale processes detected, cleaning up before launch:"
                found=1
            fi
            c=$(cat "/proc/$pid/comm" 2>/dev/null)
            echo "  kill -9 stale pid=$pid ($c)"
            kill -9 "$pid" 2>/dev/null
        done
    done
    for pid in $(pgrep -f 'python.*umu-run.*\(RSF_Launcher\|Rallysimfans\)' 2>/dev/null); do
        if [ "$pid" = "$$" ] || [ "$pid" = "$BASHPID" ]; then continue; fi
        cmdline=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)
        case "$cmdline" in
            *richard-wrapper*|*wrapper.sh*|*runrbr_simhub.sh*) continue ;;
        esac
        if [ "$found" -eq 0 ]; then
            echo "[$(date '+%F %T')] stale umu-run for RBR found:"
            found=1
        fi
        c=$(cat "/proc/$pid/comm" 2>/dev/null)
        echo "  kill_tree stale umu-run pid=$pid ($c)"
        kill_tree "$pid"
    done
    # Whatever is still holding the prefix: survivors of an earlier launch (their
    # wineserver is long gone, so they'll never notice their parent died), a
    # SimHub we're about to replace, and everything killed above. TERM first —
    # a wineserver that exits cleanly tears its socket down properly, which is
    # what lets the next session start on a clean slate.
    if [ -n "$(prefix_pids)" ]; then
        if [ "$found" -eq 0 ]; then
            echo "[$(date '+%F %T')] processes still holding $PREFIX:"
            found=1
        fi
        sweep_prefix TERM
        if ! wait_prefix_clear "$PREFIX_TERM_WAIT"; then
            echo "[$(date '+%F %T')] forcing the stragglers out:"
            sweep_prefix 9
            wait_prefix_clear "$PREFIX_CLEAR_TIMEOUT" ||
                echo "[$(date '+%F %T')] WARNING: launching into a prefix that is not clear"
        fi
    fi
    [ "$found" -eq 1 ] && sleep 1
    return 0
}

list_our_processes() {
    local p comm seen=" "
    if [ -n "$GAME_PID" ] && kill -0 "$GAME_PID" 2>/dev/null; then
        for p in $(collect_subtree "$GAME_PID"); do
            comm=$(cat "/proc/$p/comm" 2>/dev/null)
            printf '  %s %s [umu subtree]\n' "$p" "$comm"
            seen+="$p "
        done
    fi
    for p in $(pgrep -x "$SIMHUB_COMM" 2>/dev/null); do
        case "$seen" in *" $p "*) continue ;; esac
        comm=$(cat "/proc/$p/comm" 2>/dev/null)
        printf '  %s %s [SimHub]\n' "$p" "$comm"
        seen+="$p "
    done
    for p in $(prefix_pids); do
        case "$seen" in *" $p "*) continue ;; esac
        comm=$(cat "/proc/$p/comm" 2>/dev/null)
        printf '  %s %s [prefix]\n' "$p" "$comm"
        seen+="$p "
    done
}

cleanup() {
    local rc=$?
    echo "[$(date '+%F %T')] cleanup() entered (rc=$rc, mode=$MODE, GAME_PID=$GAME_PID)"
    echo "[$(date '+%F %T')] our processes before cleanup:"
    list_our_processes
    if [ -n "$GAME_PID" ]; then
        echo "[$(date '+%F %T')] kill_tree $GAME_PID:"
        kill_tree "$GAME_PID"
    fi
    if [ "$MODE" = "game-simhub" ]; then
        echo "[$(date '+%F %T')] killing SimHub by comm:"
        kill_by_comm "$SIMHUB_COMM"
        sleep 1
    else
        echo "[$(date '+%F %T')] mode=$MODE — leaving SimHub alone"
    fi
    # Ask anything left in the prefix to go while wineserver is still up — a
    # wine process orphaned by a dead wineserver can no longer shut itself down.
    echo "[$(date '+%F %T')] prefix sweep (TERM):"
    sweep_prefix TERM
    sleep 1
    echo "[$(date '+%F %T')] fallback pkills:"
    local name
    for name in "$LAUNCHER_COMM" "$GAME_COMM" "$INSTALLER_COMM" \
                "explorer.exe" "conhost.exe" "rpcss.exe" "plugplay.exe" \
                "svchost.exe" "services.exe" "start.exe" "tabtip.exe" \
                "winedevice.exe" "wineserver"; do
        kill_by_comm "$name"
    done
    sleep 1
    # Whatever outlived all of the above — helpers the game's plugins spawned
    # under names we don't know. Leaving one behind keeps lutris-wrapper alive
    # and Lutris thinks the game is still running.
    echo "[$(date '+%F %T')] prefix sweep (KILL):"
    sweep_prefix 9
    if [ -n "$HANDOFF_FILE" ] && [ -e "$HANDOFF_FILE" ]; then
        echo "[$(date '+%F %T')] removing winehub handoff: $HANDOFF_FILE"
        rm -f "$HANDOFF_FILE"
    fi
    wait_prefix_clear 5 >/dev/null || true
    echo "[$(date '+%F %T')] survivors after cleanup:"
    list_our_processes
    echo "[$(date '+%F %T')] cleanup() done"
}
trap cleanup EXIT
trap 'echo "[$(date '"'"'+%F %T'"'"')] received SIGTERM/SIGINT"; exit 0' TERM INT

stale_cleanup

# Drop the winehub handoff for game launches (not the installer) so a winehub
# watching the SimHub prefix can mirror RBR's folder + run its detection stub.
if [ "$MODE" != "installer" ] && [ -n "$RBR_INSTALL_DIR" ]; then
    mkdir -p "$HANDOFF_DIR"
    printf '%s\n' "$RBR_INSTALL_DIR" > "$HANDOFF_FILE"
    echo "[$(date '+%F %T')] winehub handoff: $HANDOFF_FILE -> $RBR_INSTALL_DIR"
fi

"${FILTERED_ARGS[@]}" &
GAME_PID=$!
echo "[$(date '+%F %T')] launched host pid=$GAME_PID: ${FILTERED_ARGS[*]}"

if [ "$MODE" = "game-simhub" ]; then
    (
        # Wait for the game's wine session to come up before adding a second one.
        # On a blind timer this lands mid-prefix-setup (worst after we just tore
        # down a running SimHub, which makes proton's setup take longer) and the
        # RSF launcher never appears.
        waited=0; seen=0
        while [ "$seen" -eq 0 ]; do
            if launcher_alive || game_alive; then
                seen=1
                echo "[$(date '+%F %T')] launcher up after ${waited}s"
                break
            fi
            if ! kill -0 "$GAME_PID" 2>/dev/null; then
                echo "[$(date '+%F %T')] host process gone before the launcher appeared — not starting SimHub"
                exit 0
            fi
            if [ "$waited" -ge "$SIMHUB_WAIT_MAX" ]; then
                echo "[$(date '+%F %T')] launcher not seen after ${waited}s — starting SimHub anyway"
                break
            fi
            sleep 1
            waited=$((waited + 1))
        done
        echo "[$(date '+%F %T')] settling ${SIMHUB_START_DELAY}s before starting SimHub"
        sleep "$SIMHUB_START_DELAY"
        if [ -f "$SIMHUB_EXE" ]; then
            echo "[$(date '+%F %T')] starting SimHub: $WINE_BIN $SIMHUB_EXE"
            "$WINE_BIN" "$SIMHUB_EXE" >>"$LOG" 2>&1 &
            echo "[$(date '+%F %T')] SimHub launched pid=$!"
        else
            echo "[$(date '+%F %T')] SimHub not found at: $SIMHUB_EXE"
        fi
    ) &
else
    echo "[$(date '+%F %T')] mode=$MODE — skipping SimHub launch"
fi

game_seen=0; launcher_seen=0; installer_seen=0; heartbeat=0
while true; do
    if ! kill -0 "$GAME_PID" 2>/dev/null; then
        echo "[$(date '+%F %T')] umu-run pid=$GAME_PID exited on its own"
        break
    fi
    case "$MODE" in
        installer)
            if installer_alive; then
                [ "$installer_seen" -eq 0 ] && echo "[$(date '+%F %T')] installer process detected — running"
                installer_seen=1
            elif [ "$installer_seen" -eq 1 ]; then
                echo "[$(date '+%F %T')] installer process gone — cleanup"
                sleep "$GRACE_AFTER_GAME"; break
            fi
            ;;
        game-only|game-simhub)
            if game_alive; then
                [ "$game_seen" -eq 0 ] && echo "[$(date '+%F %T')] rally process detected alive — session started"
                game_seen=1
            elif [ "$game_seen" -eq 1 ]; then
                echo "[$(date '+%F %T')] rally process no longer alive — session ended"
                echo "[$(date '+%F %T')] grace ${GRACE_AFTER_GAME}s before forcing cleanup..."
                sleep "$GRACE_AFTER_GAME"
                if ! kill -0 "$GAME_PID" 2>/dev/null; then
                    echo "[$(date '+%F %T')] umu-run cleaned up on its own during grace"
                else
                    echo "[$(date '+%F %T')] umu-run still alive after grace — forcing cleanup"
                fi
                break
            fi
            if launcher_alive; then
                launcher_seen=1
            elif [ "$launcher_seen" -eq 1 ] && [ "$game_seen" -eq 0 ]; then
                echo "[$(date '+%F %T')] launcher gone without a rally — ${GRACE_AFTER_GAME}s to be sure"
                sleep "$GRACE_AFTER_GAME"
                if launcher_alive || game_alive; then
                    echo "[$(date '+%F %T')] launcher/game back — carrying on"
                    continue
                fi
                echo "[$(date '+%F %T')] launcher still gone — cleaning up"
                break
            fi
            ;;
    esac

    heartbeat=$((heartbeat + POLL_INTERVAL))
    if [ "$heartbeat" -ge "$HEARTBEAT_INTERVAL" ]; then
        echo "[$(date '+%F %T')] heartbeat: mode=$MODE game_seen=$game_seen launcher_seen=$launcher_seen installer_seen=$installer_seen, our processes:"
        list_our_processes
        heartbeat=0
    fi
    sleep "$POLL_INTERVAL"
done
exit 0
